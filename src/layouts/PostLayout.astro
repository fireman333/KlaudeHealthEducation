---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { CommentBox } from '@/components/react/CommentBox';
import { COMMENTS } from '@/config';

interface Source {
  title: string;
  url: string;
  note?: string;
}

interface CarouselSlide {
  src: string;
  alt: string;
  caption?: string;
  threads_text?: string;
}

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    summary: string;
    categories: string[];
    tags: string[];
    sources: Source[];
    carousel?: CarouselSlide[];
    description?: string;
  };
  slug: string;
}

const { frontmatter, slug } = Astro.props;
const { title, date, summary, categories, sources, carousel, description } = frontmatter;
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, '');
function resolveSrc(src: string): string {
  if (/^https?:\/\//.test(src)) return src;
  return `${baseUrl}${src.startsWith('/') ? src : `/${src}`}`;
}

const dateStr = date.toISOString().slice(0, 10);
const dateDisplay = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;

function categoryHref(c: string): string {
  return `${import.meta.env.BASE_URL}categories/${encodeURIComponent(c)}/`.replace(/\/+/g, '/');
}
---

<BaseLayout title={title} description={description ?? summary}>
  <div class="post-layout">
    <article class="post-layout__main">
      <header class="article-header">
      {categories.length > 0 && (
        <div class="article-categories">
          {categories.map((c) => (
            <a class="chip" href={categoryHref(c)}>{c}</a>
          ))}
        </div>
      )}
      <h1 class="article-title">{title}</h1>
      <p class="article-meta">
        <time datetime={dateStr}>{dateDisplay}</time>
      </p>
      <p class="article-summary">{summary}</p>
      <aside class="disclaimer-banner" role="note">
        <p class="byline">作者：<strong>康瑋麟</strong>｜台大醫學系大六學生（<strong>非主治醫師</strong>）</p>
        <p class="byline-disclaimer">本文為衛教整理，<strong>不構成個別醫療建議</strong>。文中臨床情境如未另註明皆為合成，非真實病人。實際治療決策請與您的主治醫師討論。</p>
      </aside>
    </header>

    {carousel && carousel.length > 0 && (
      <section class="article-carousel" aria-label="圖片懶人包">
        <div class="article-carousel__track">
          {carousel.map((slide, i) => (
            <figure class="article-carousel__slide">
              <img
                src={resolveSrc(slide.src)}
                alt={slide.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                width="1080"
                height="1080"
              />
              {slide.caption && (
                <figcaption class="article-carousel__caption">{slide.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
        <p class="article-carousel__hint">← 滑動瀏覽 {carousel.length} 張懶人包 →</p>
      </section>
    )}

    <div class="article-body">
      <slot />
    </div>

    {sources.length > 0 && (
      <section class="article-sources">
        <h3>參考資料</h3>
        <ol>
          {sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
              {s.note && <span class="article-sources__note">{s.note}</span>}
            </li>
          ))}
        </ol>
      </section>
    )}

    <CommentBox
      client:idle
      slug={slug}
      apiBase={COMMENTS.apiBase}
      turnstileSiteKey={COMMENTS.turnstileSiteKey}
    />
    </article>

    <aside class="post-layout__sidebar post-layout__sidebar--desktop" aria-label="文章導覽">
      <Sidebar />
    </aside>
  </div>

  <details class="post-layout__sidebar-mobile">
    <summary class="post-layout__sidebar-summary">瀏覽其他文章</summary>
    <Sidebar />
  </details>
</BaseLayout>
