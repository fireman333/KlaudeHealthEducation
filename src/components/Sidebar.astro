---
// Sidebar — desktop ≥1024px shows as right column;
// mobile <1024px wrapped in <details> by PostLayout.
// Sections render in fixed order: Pinned → Timeline → Popular.
// Popular section is OMITTED from MVP per spec Requirement 5
// (openspec/changes/desktop-sidebar/specs/desktop-sidebar/spec.md).
// Phase 2 trigger (≥15 posts + ≥5 with ≥3 comments) unlocks Popular.

import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, '');

function postHref(slug: string): string {
  return `${baseUrl}/posts/${slug}/`;
}

function formatDate(d: Date): string {
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}

function yearMonth(d: Date): string {
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
}

const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);

const pinnedPosts = allPosts
  .filter((p) => p.data.pinned === true)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const timelineSorted = [...allPosts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const timelineGroups = new Map<string, typeof timelineSorted>();
for (const post of timelineSorted) {
  const key = yearMonth(post.data.date);
  if (!timelineGroups.has(key)) timelineGroups.set(key, []);
  timelineGroups.get(key)!.push(post);
}
---

<div class="sidebar">
  <section class="sidebar-section" data-section="pinned">
    <h2 class="sidebar-section__heading">精選</h2>
    {pinnedPosts.length === 0 ? (
      <p class="sidebar-section__placeholder">還沒釘選任何文章</p>
    ) : (
      <ul class="sidebar-section__items">
        {pinnedPosts.map((p) => (
          <li>
            <a class="sidebar-section__item-link" href={postHref(p.slug)}>
              {p.data.title}
              <span class="sidebar-section__item-date">{formatDate(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="sidebar-section" data-section="timeline">
    <h2 class="sidebar-section__heading">時間軸</h2>
    {timelineGroups.size === 0 ? (
      <p class="sidebar-section__placeholder">尚無文章</p>
    ) : (
      <div class="sidebar-timeline">
        {Array.from(timelineGroups.entries()).map(([ym, posts]) => (
          <div class="sidebar-timeline__group">
            <h3 class="sidebar-timeline__heading">{ym}</h3>
            <ul class="sidebar-section__items">
              {posts.map((p) => (
                <li>
                  <a class="sidebar-section__item-link" href={postHref(p.slug)}>
                    {p.data.title}
                    <span class="sidebar-section__item-date">{formatDate(p.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
</div>
